# Example environment variables for EduScheduler
# Copy this file to .env and .env.production and fill in your values

# Frontend Public Variables (safe to expose)
VITE_PUBLIC_BUILDER_KEY=your_builder_api_key_here
VITE_PUBLIC_API_BASE_URL=http://localhost:8080/api

# Backend Variables
NODE_ENV=development
PORT=8080

# Database (if using)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/edusched
MONGO_URI=mongodb://localhost:27017/edusched

# Optional: Third-party Services
# SMTP Configuration for email notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@edusched.com

# Optional: Sentry for error tracking
SENTRY_DSN=

# Optional: Analytics
GOOGLE_ANALYTICS_ID=

# Optional: File Upload (if using S3/Cloud Storage)
AWS_S3_BUCKET=
AWS_S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional: Authentication (if using OAuth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: Notification/Messaging
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Optional: Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Application Settings
APP_NAME=EduScheduler
APP_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000,http://localhost:8080
